{
  "name": "drinks",
  "private": true,
  "version": "0.1.0",
  "description": "DrinkS, bar en casa: tienda de bebidas y recetario (frontend con datos de muestra).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "check:size": "node scripts/check-file-size.mjs",
    "verify": "npm run lint && npm run check:size && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/caprasimo": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "sass": "^1.105.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
